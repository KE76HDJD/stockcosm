# Backend — Copy to .env and fill in real values
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5435/gestion_stock_cosmetiques
SECRET_KEY=CHANGE_ME_GENERATE_WITH: python3 -c "import secrets; print(secrets.token_hex(64))"
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
ENVIRONMENT=production
ALGORITHM=HS256
GEMINI_API_KEY=
TOTP_ISSUER=KET SKIN CARE
COOKIE_SECURE=true

DB_HOST=localhost
DB_PORT=5435
DB_NAME=gestion_stock_cosmetiques
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

CORS_ORIGINS=["http://localhost:8443","https://YOUR-URL.trycloudflare.com"]
